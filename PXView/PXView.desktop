[Desktop Entry]
Type=Application
Encoding=UTF-8
Name=PXView
Comment=GUI Program for PXLogic USB-based Instruments
TryExec=pxview-launcher
Exec=pxview-launcher
Icon=pxview
Terminal=false
# Match the window class of the Qt binary, so that the shell associates
# the running window with this desktop entry and shows its icon.
StartupWMClass=PXView
Actions=Classic;Agent;
Categories=Development;Electronics;Qt;

[Desktop Action Classic]
Name=Launch classic PXView GUI
Exec=pxview-launcher

[Desktop Action Agent]
Name=Launch PXView Agent (Tauri)
Exec=pxview-launcher agent
